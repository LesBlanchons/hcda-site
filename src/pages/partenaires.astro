---
import Layout from '../layouts/Layout.astro';

const benefices = [
  { titre: 'Visibilité', texte: 'Sur la patinoire et lors des événements du club.' },
  { titre: 'Votre logo', texte: 'Sur les maillots et les supports du club.' },
  { titre: 'Valorisez', texte: 'Votre entreprise auprès d\'un public local et touristique.' },
  { titre: 'Ensemble', texte: 'Pour le développement du hockey aux Deux Alpes.' },
];
---
<Layout
  title="Partenaires"
  description="Devenez partenaire du Hockey Club des Deux Alpes — Les Blanchons : soutenez la relance du club et gagnez en visibilité auprès d'un public local et touristique."
>
  <section class="hero hero-photo" style="background-image:url('/images/mountains-sunset.jpg');">
    <div class="container">
      <h1>Devenez partenaire</h1>
      <p>Une passion, un club, un territoire — soutenez la relance du hockey aux Deux Alpes.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Ils nous soutiennent déjà</h2>
      <div class="grid grid-3">
        <div class="partner-tile" style="display:flex; align-items:center; justify-content:center; padding:1.4rem; text-transform:none;">
          <img src="/images/partenaires/promoglace-logo.png" alt="Logo Promoglace" style="max-width:170px; width:100%;" />
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Pourquoi devenir partenaire</h2>
      <div class="grid grid-3">
        {benefices.map((b) => (
          <div class="card">
            <h3>{b.titre}</h3>
            <p>{b.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="card">
        <h2>Soutenez une équipe, un projet</h2>
        <p>
          Partenaires aujourd'hui, acteurs de demain : rejoignez les entreprises qui
          accompagnent la relance des Blanchons des Deux Alpes.
        </p>
        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
          <a class="btn btn-accent" href="/contact/">Devenir partenaire</a>
          <a class="btn btn-outline" style="background:var(--color-primary); color:#fff;" href="/downloads/plaquette-partenaires.jpg" target="_blank" rel="noopener">Voir la plaquette partenaires</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
