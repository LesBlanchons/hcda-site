---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout
  title="Actualités"
  description="Toute l'actualité du Hockey Club des Deux Alpes — Les Blanchons : vie du club, résultats, événements."
>
  <section class="hero">
    <div class="container">
      <h1>Actualités</h1>
      <p>Les dernières nouvelles du club.</p>
    </div>
  </section>

  <section>
    <div class="container">
      {posts.length === 0 && <p>Aucun article pour le moment — revenez bientôt !</p>}
      <div class="grid grid-2">
        {posts.map((post) => (
          <a class="card" style="text-decoration:none; color:inherit;" href={`/blog/${post.id}/`}>
            <p class="tag">{post.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <h2 style="margin:0.5rem 0;">{post.data.title}</h2>
            <p style="color:var(--color-text-muted);">{post.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
