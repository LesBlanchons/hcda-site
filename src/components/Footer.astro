---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-content">
    <div class="container footer-grid">
      <div>
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:1rem;">
          <span class="brand-badge" style="width:38px; height:38px;">
            <img src="/images/logo.png" alt="" width="30" height="30" />
          </span>
          <strong style="font-size:0.95rem; color:#fff; text-transform:uppercase; letter-spacing:0.02em;">Les Blanchons<br /><span style="font-weight:600; font-size:0.72rem; color:var(--muted); letter-spacing:0.08em;">des Deux Alpes</span></strong>
        </div>
        <p style="font-style:italic; font-size:0.85rem; color:var(--muted); max-width:220px; margin:0;">« Une montagne. Une passion. Une famille. »</p>
      </div>
      <div>
        <p class="tag" style="margin-bottom:1rem;">Liens utiles</p>
        <div style="display:flex; flex-direction:column; gap:0.6rem;">
          <a href="/partenaires/">Devenir partenaire</a>
          <a href="/mentions-legales/">Mentions légales</a>
          <a href="/politique-de-confidentialite/">Politique de confidentialité</a>
          <a href="/contact/">Nous contacter</a>
        </div>
      </div>
      <div>
        <p class="tag" style="margin-bottom:1rem;">Contact</p>
        <div style="display:flex; flex-direction:column; gap:0.6rem;">
          <a href="mailto:lesblanchonsdesalpes@gmail.com">lesblanchonsdesalpes@gmail.com</a>
          <span>Les Deux Alpes, Isère</span>
        </div>
      </div>
      <div>
        <p class="tag" style="margin-bottom:1rem;">Nous suivre</p>
        <div style="display:flex; flex-direction:column; gap:0.6rem;">
          <a href="/blog/">Actualités du club</a>
        </div>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Les Blanchons des Deux Alpes · Association loi 1901</span>
    <span style="display:flex; gap:1.25rem;">
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/politique-de-confidentialite/">Confidentialité</a>
    </span>
  </div>
</footer>
