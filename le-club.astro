---
import Layout from '../layouts/Layout.astro';

const bureau = [
  { role: 'Président', name: 'Corentin Picaud', initials: 'CP' },
  { role: 'Secrétaire', name: 'Clément Guignard', initials: 'CG' },
  { role: 'Trésorier', name: 'Hervé Picaud', initials: 'HP' },
];

const valeurs = ['Passion', 'Plaisir', 'Respect', "Esprit d'équipe"];
---
<Layout
  title="Le club"
  description="Présentation du Hockey Club des Deux Alpes — Les Blanchons : association loi 1901, bureau fondateur, valeurs et projet du club."
>
  <section class="hero hero-photo" style="background-image:url('/images/mountains-day.jpg'); padding:4.5rem 0 5rem;">
    <div class="container reveal">
      <div style="font-size:0.8rem; color:var(--muted); margin-bottom:1.3rem;">Accueil / <span style="color:#fff;">Le club</span></div>
      <div class="pill-glass">
        <span class="dot-accent"></span>
        <span class="eyebrow" style="margin:0;">Le club</span>
      </div>
      <h1 style="margin-top:0.2rem;">Notre histoire</h1>
      <p>Une association loi 1901 qui relance le hockey sur glace et le roller hockey aux Deux Alpes.</p>
    </div>
  </section>

  <section>
    <div class="container grid" style="grid-template-columns:0.9fr 1.1fr; gap:3.5rem; align-items:center;">
      <div class="grid grid-2" style="grid-template-columns:1fr 1fr; gap:1rem;">
        <div class="img-zoom reveal" style="margin-top:2.5rem;">
          <img src="/images/team-kids.jpg" alt="Jeune équipe des Blanchons des Deux Alpes en tenue orange et blanche" style="height:300px; object-fit:cover;" />
        </div>
        <div class="img-zoom reveal" style="animation-delay:.1s;">
          <img src="/images/team-adult-historic.jpg" alt="Équipe adulte des Blanchons des Deux Alpes lors d'un match sur la patinoire extérieure" style="height:300px; object-fit:cover;" />
        </div>
      </div>
      <div>
        <p class="eyebrow">Depuis plusieurs années</p>
        <h2 style="font-size:1.9rem; text-transform:none; line-height:1.2;">Une histoire qui reprend.</h2>
        <p style="color:var(--muted-ink); margin-top:1.2rem; max-width:440px;">
          Les Blanchons des Deux Alpes existent depuis plusieurs années dans la mémoire de la
          station : équipes de hockey et de roller hockey, séances sur la patinoire extérieure,
          maillots orange et noir devenus familiers.
        </p>
        <p style="color:var(--muted-ink); margin-top:1rem; max-width:440px;">
          Après une pause, le club se structure aujourd'hui en association loi 1901 pour repartir
          sur de nouvelles bases et faire vivre cette passion sur le long terme — pour toutes les générations.
        </p>
      </div>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="container" style="max-width:720px;">
      <p class="eyebrow">Notre projet</p>
      <h2 style="font-size:1.7rem; text-transform:none;">Un club ouvert à toutes et tous.</h2>
      <p style="color:var(--muted-ink); margin-top:1rem;">
        Enfants comme adultes, débutants comme confirmés : l'objectif est une pratique régulière
        l'hiver sur la patinoire, et l'été en roller hockey.
      </p>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">Nos valeurs</p>
      <h2 style="font-size:1.8rem; text-transform:none; margin-bottom:1.6rem;">Plus qu'un club.</h2>
      <div class="grid grid-3" style="grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));">
        {valeurs.map((v, i) => (
          <div class="card-dark reveal" style={`animation-delay:${i * 0.06}s;`}>
            <span style="font-size:0.8rem; font-weight:700; color:var(--accent);">{String(i + 1).padStart(2, '0')}</span>
            <div style="font-weight:700; font-size:1rem; color:#fff; margin-top:0.8rem; text-transform:uppercase;">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="container">
      <p class="eyebrow">L'équipe</p>
      <h2 style="font-size:1.8rem; text-transform:none; margin-bottom:1.6rem;">Le bureau fondateur</h2>
      <div class="grid grid-3">
        {bureau.map((membre, i) => (
          <div class="card reveal" style={`text-align:center; animation-delay:${i * 0.06}s;`}>
            <div style="width:76px; height:76px; border-radius:50%; background:var(--navy); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.3rem; font-weight:900; margin:0 auto 1.1rem;">{membre.initials}</div>
            <div style="font-weight:700; font-size:1rem;">{membre.name}</div>
            <p class="tag" style="margin-top:0.5rem;">{membre.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="container" style="background:var(--off); border-radius:var(--radius); padding:2.6rem; display:grid; grid-template-columns:1fr 1fr; gap:2.2rem; align-items:center;">
      <div>
        <p class="eyebrow">Gouvernance</p>
        <h2 style="font-size:1.5rem; text-transform:none;">Une association loi 1901</h2>
      </div>
      <p style="color:var(--muted-ink); font-size:0.9rem; margin:0;">
        Le club est administré par un conseil d'administration (3 membres minimum, sans maximum,
        mandat de 3 ans) et fonctionne selon des statuts centrés sur le développement du hockey
        sur glace, du roller hockey et des disciplines associées.
      </p>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal">
      <div>
        <p class="eyebrow">Rejoins l'aventure</p>
        <h2>Prêt à chausser les patins ?</h2>
      </div>
      <div style="display:flex; gap:1rem; flex-shrink:0; flex-wrap:wrap;">
        <a href="/evenements/" class="btn btn-accent">Séances tests décembre</a>
        <a href="/contact/" class="btn btn-outline">Nous contacter</a>
      </div>
    </div>
  </section>
</Layout>
